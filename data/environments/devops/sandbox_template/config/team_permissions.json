  "policies": {
    "read": {
      "description": "Policies for read (contributor) permission level",
      "deploy_keys": {"rule": "read_only=true required"},
      "access_tokens": {"rule": "read scopes only (read:repo, read:packages)", "allowed_scopes": ["read:repo", "read:packages"]},
      "webhooks": {"rule": "trusted domains only, limited events", "allowed_domains": ["slack.com", "discord.com", "*.github.io", "*.vercel.app"], "allowed_events": ["deployment_status", "workflow_run"]},
      "deployments": {"rule": "staging only", "allowed_environments": ["staging"], "allowed_branches": ["main"]},
      "file_operations": {"rule": "read only — file modifications must go through pull requests", "allowed_actions": ["read"]},
      "pull_requests": {"rule": "cannot merge", "allowed_actions": ["comment"]},
      "pipelines": {"rule": "small runners only, 30 min timeout", "allowed_runner_sizes": ["small"], "max_timeout_minutes": 30}
    },
    "write": {
      "description": "Policies for write (maintainer) permission level",
      "deploy_keys": {"rule": "read_only=true by default, write requires approval"},
      "access_tokens": {"rule": "read and write scopes allowed, admin requires approval", "allowed_scopes": ["read:repo", "read:packages", "write:repo", "write:packages"]},
      "webhooks": {"rule": "any domain allowed with extended events", "allowed_events": ["deployment_status", "workflow_run", "pull_request", "issues"]},
      "deployments": {"rule": "staging and development, production requires approval", "allowed_environments": ["staging", "development"], "allowed_branches": ["main", "develop", "release/*"]},
      "file_operations": {"rule": "can modify files specified in approved requests", "allowed_actions": ["read", "write", "delete"]},
      "pull_requests": {"rule": "can merge after review", "allowed_actions": ["comment", "review", "merge"]},
      "pipelines": {"rule": "medium runners allowed, 60 min timeout", "allowed_runner_sizes": ["small", "medium"], "max_timeout_minutes": 60}
    },
    "admin": {
      "description": "Policies for admin permission level",
      "deploy_keys": {"rule": "full access"},
      "access_tokens": {"rule": "all scopes allowed", "allowed_scopes": ["read:repo", "read:packages", "write:repo", "write:packages", "admin:repo", "admin:org"]},
      "webhooks": {"rule": "full access", "allowed_events": ["push", "pull_request", "deployment_status", "workflow_run", "issues", "repository", "member", "create", "delete"]},
      "deployments": {"rule": "all environments allowed", "allowed_environments": ["staging", "development", "production"], "allowed_branches": ["*"]},
      "file_operations": {"rule": "full access", "allowed_actions": ["read", "write", "delete"]},
      "pull_requests": {"rule": "full access", "allowed_actions": ["comment", "review", "merge", "force_merge"]},
      "pipelines": {"rule": "all runners, no timeout limit", "allowed_runner_sizes": ["small", "medium", "large", "xlarge"], "max_timeout_minutes": 360}
    }
  },
